{
  "name": "uranai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx --conditions=react-server scripts/seed.ts",
    "admin:create": "tsx --conditions=react-server scripts/create-admin.ts",
    "e2e": "tsx --conditions=react-server scripts/e2e-flow.ts",
    "vercel-build": "tsx scripts/migrate.ts && next build",
    "e2e:firestore": "tsx --conditions=react-server scripts/e2e-firestore.ts",
    "e2e:setup": "tsx --conditions=react-server scripts/e2e-setup.ts",
    "e2e:admin": "tsx --conditions=react-server scripts/e2e-admin-empty.ts",
    "e2e:store": "tsx --conditions=react-server scripts/e2e-store-security.ts",
    "emulator": "npx -y firebase-tools@15 emulators:start --only firestore --project demo-uranai",
    "check:payments": "tsx --conditions=react-server scripts/check-payment-kinds.ts",
    "check:env": "tsx scripts/check-env.ts",
    "backup:firestore": "tsx scripts/firestore-backup.ts backup",
    "backup:verify": "tsx scripts/firestore-backup.ts verify",
    "backup:restore-emulator": "tsx scripts/firestore-backup.ts restore-emulator",
    "e2e:backup": "tsx scripts/e2e-backup.ts",
    "e2e:dev-mode": "tsx --conditions=react-server scripts/e2e-dev-mode.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.3",
    "firebase-admin": "^14.5.0",
    "next": "16.3.8",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.5",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
}
