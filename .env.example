# ---- データベース ----
# Cloud Firestore（推奨）: 次の3つを設定すると自動的に Firestore を使う。
#   値はサービスアカウントの秘密鍵JSONの project_id / client_email / private_key。
#   ※ JSONファイル自体はリポジトリに置かないこと（.gitignore 済み）。Vercel の環境変数に登録する
FIREBASE_PROJECT_ID=
# 本番の Firebase プロジェクトID（秘密情報ではない）。Preview（開発・テスト環境）では必須:
#   Preview の FIREBASE_PROJECT_ID がこれと同じ、またはこれが未設定だと、データベースへのアクセスを停止する（本番データを守るため）
PRODUCTION_FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
#   "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"（\n 表記のままでも実際の改行でも可）
FIREBASE_PRIVATE_KEY=
# ローカルで Firestore Emulator を使う場合（npm run emulator）。本番では設定しない
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# 保存先を明示する場合のみ（firestore / postgres）。通常は不要
# DB_PROVIDER=

# PostgreSQL（Firestore 移行の確認が終わるまで残している従来方式。Firestore 利用時は不要）
DATABASE_URL=postgres://postgres@localhost:5432/uranai

# ---- 必須 ----
# 公開URL（QRコードのURLに使用）。本番は https://。Vercel で未設定なら本番ドメインを自動使用
APP_URL=http://localhost:3000
# 32文字以上のランダム文字列: `openssl rand -base64 48`
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# 口座情報の暗号化キー（base64の32byte）: `openssl rand -base64 32`（振込先を登録する時に必要）
DATA_ENCRYPTION_KEY=

# ---- 決済 ----
# テストモード: true のときだけ、決済をスキップして無料で 選択→入力→占い→結果 まで確認できる
#   ・トップ(/) または /s/test（テスト店舗）から開始。DB未接続でも動作する
#   ・売上（transactions 等）には一切記録しない。利用記録は test_fortune_logs にのみ保存
# 本番決済を導入したら false（または削除）にする。false にすると決済成功の確認なしでは占えない
# Vercel の本番（VERCEL_ENV=production）では true のままだと、運営・店舗アカウントも含め占いの受付（無料テスト・有料とも）を停止する。
#   管理画面は使える。/api/health と運営ダッシュボードに警告が出る
ENABLE_TEST_PAYMENT=false
# 本番決済プロバイダ（現在は payjp。将来 Stripe 等を追加する場合は src/lib/payments に実装を追加）
PAYMENT_PROVIDER=payjp
# PAY.JP（テスト環境は pk_test_ / sk_test_）。秘密鍵は絶対にフロントへ置かない
# テスト用キーでの決済（livemode=false）は、売上・店舗の取り分・月次精算に含めない（運営の決済履歴には「テスト決済・集計外」として表示）
# 疑似決済（PAYMENT_PROVIDER=mock）は Vercel の本番では ALLOW_MOCK_PAYMENTS_IN_PRODUCTION=true でも使えない（占いの受付を停止）
PAYJP_PUBLIC_KEY=
PAYJP_SECRET_KEY=
# PAY.JP管理画面 > API > Webhook の「Webhookトークン」
PAYJP_WEBHOOK_TOKEN=
# 自動テスト（npm run e2e）用の疑似決済の署名鍵。通常は不要
MOCK_WEBHOOK_SECRET=
# 手数料率の既定値（bps, 360=3.6%）。PAY.JP は charge.fee_rate を優先
PAYMENT_FEE_RATE_BPS=360

# ---- 公開状態 ----
# 準備中モード: coming_soon にすると、一般の方には「ただいま準備中です」を表示し、無料テスト・決済とも受け付けない（管理画面は使える）。
# 本番のヘルスチェックでは正常な状態として扱う。公開するときは削除（または open）して再デプロイする。
# 開発モード: development にすると、一般の方・店舗アカウントには準備中を表示し、決済の API は誰に対しても停止する。
#   運営アカウント（OPERATOR）でログイン中の人だけ、テスト店舗（/s/test）と稼働中の登録店舗の QR で無料の占いを確認できる
#   （実店舗の分はその店舗の無料テスト利用件数に記録。料金・売上・取り分は0円。
#   決済・売上のデータは作らず、testFortuneLogs に mode=development で記録するだけ）。
#   安全な SESSION_SECRET が必須。本番用の決済キー（sk_live_ / pk_live_ / rk_live_）が設定されていると全部停止する。
#   本番の ENABLE_TEST_PAYMENT=true・PAYMENT_PROVIDER=mock があるときも全部停止する（危険な設定を優先）
# open・coming_soon・development 以外の値は、意図せず公開しないよう準備中として扱う
# SITE_STATUS=coming_soon

# ---- 運用 ----
# /api/cron/maintenance 用 Bearer トークン（本番では必須。未設定だと定期処理が実行されず、/api/health が ok=false になる）
# 実行結果（最終成功時刻など）は /api/health と運営ダッシュボードで確認できる（Firestore のみ記録）
CRON_SECRET=
# 任意: /admin/setup（最初の運営アカウント作成）で入力を求めるセットアップキー。作成後は削除してよい
ADMIN_SETUP_TOKEN=

# ---- ブランド（任意・クライアントに公開されます）----
NEXT_PUBLIC_SITE_NAME=100円占い
# NEXT_PUBLIC_SITE_TAGLINE=
# NEXT_PUBLIC_THEME_COLOR=#0b1026

# ---- 運営者情報（特定商取引法に基づく表記・利用規約・プライバシーポリシー。サーバー側でのみ使用）----
# 屋号・問い合わせ先は未設定なら src/config/operator.ts の既定値（Hobby shop FUKASHIGI / koyomi100yen@gmail.com）を表示。
# 氏名・住所・電話番号は未設定なら「ご請求があれば遅滞なく開示」と表示（法令上の条件は公開前に要確認）。
# 架空の値は設定しないこと。仮の値（example.com や【…】）は表示に使われず、/api/health と運営ダッシュボードに警告が出る。
# 以前の NEXT_PUBLIC_OPERATOR_* も読み取るが、ブラウザに公開される名前なので OPERATOR_* に移して削除すること。
# OPERATOR_TRADE_NAME=
# OPERATOR_EMAIL=
# OPERATOR_OWNER_NAME=
# OPERATOR_ADDRESS=
# OPERATOR_PHONE=
