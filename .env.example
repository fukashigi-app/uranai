# ---- 必須 ----
DATABASE_URL=postgres://postgres@localhost:5432/uranai
# 公開URL（QRコードのURLとOrigin検証に使用）。本番は https://
APP_URL=http://localhost:3000
# 32文字以上のランダム文字列: `openssl rand -base64 48`
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# 口座情報の暗号化キー（base64の32byte）: `openssl rand -base64 32`
DATA_ENCRYPTION_KEY=

# ---- 決済 ----
# payjp | mock（mock は開発/検証専用。本番では起動を拒否）
PAYMENT_PROVIDER=mock
# PAY.JP（テスト環境は pk_test_ / sk_test_）。秘密鍵は絶対にフロントへ置かない
PAYJP_PUBLIC_KEY=
PAYJP_SECRET_KEY=
# PAY.JP管理画面 > API > Webhook の「Webhookトークン」
PAYJP_WEBHOOK_TOKEN=
# Mock Webhook の HMAC 秘密鍵（16文字以上）
MOCK_WEBHOOK_SECRET=local-mock-webhook-secret-change-me
# 手数料率の既定値（bps, 360=3.6%）。PAY.JP は charge.fee_rate を優先
PAYMENT_FEE_RATE_BPS=360

# ---- 運用 ----
# /api/cron/maintenance 用 Bearer トークン
CRON_SECRET=

# ---- ブランド（任意・クライアントに公開されます）----
NEXT_PUBLIC_SITE_NAME=100円占い
# NEXT_PUBLIC_SITE_TAGLINE=
# NEXT_PUBLIC_THEME_COLOR=#0b1026
# NEXT_PUBLIC_OPERATOR_NAME=
# NEXT_PUBLIC_OPERATOR_REPRESENTATIVE=
# NEXT_PUBLIC_OPERATOR_ADDRESS=
# NEXT_PUBLIC_OPERATOR_PHONE=
# NEXT_PUBLIC_OPERATOR_EMAIL=
