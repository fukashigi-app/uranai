rules_version = '2';

// 100円占い: Firestore はブラウザ（クライアントSDK）から一切読み書きさせない。
// すべてのアクセスは Vercel 上の Next.js サーバーから Firebase Admin SDK 経由で行う
// （Admin SDK はこのルールの対象外）。店舗ごとの閲覧制限はサーバー側のコードで行う。
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
